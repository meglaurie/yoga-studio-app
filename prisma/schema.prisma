// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  OWNER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum ProductType {
  DROP_IN
  CLASS_PASS
  MONTHLY_MEMBERSHIP
  ANNUAL_MEMBERSHIP
}

enum ClassLevel {
  BEGINNER
  ALL_LEVELS
  INTERMEDIATE
  ADVANCED
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
}

enum NotificationType {
  CLASS_CANCELLED
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role          Role           @default(MEMBER)
  status        UserStatus     @default(ACTIVE)
  bookings      Booking[]
  purchases     Purchase[]
  classPasses   ClassPass[]
  memberships   Membership[]
  classes       Class[]        @relation("ClassCreator")
  notifications Notification[]

  @@index([status])
}

model Class {
  id             String     @id @default(cuid())
  name           String
  description    String?
  instructorName String
  level          ClassLevel
  startAt        DateTime
  endAt          DateTime
  capacity       Int

  createdById String
  createdBy   User        @relation("ClassCreator", fields: [createdById], references: [id])
  status      ClassStatus @default(SCHEDULED)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([createdById])
  @@index([status])
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  classId       String
  attendeeCount Int           @default(1)
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  class        Class                @relation(fields: [classId], references: [id])
  creditUsages BookingCreditUsage[]

  @@unique([userId, classId])
  @@index([classId])
  @@index([userId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        ProductType
  priceCents  Int
  currency    String      @default("CAD")
  creditCount Int?
  active      Boolean     @default(true)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id          String         @id @default(cuid())
  userId      String
  productId   String
  amountCents Int
  currency    String         @default("CAD")
  status      PurchaseStatus @default(PENDING)

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  classPass  ClassPass?
  membership Membership?

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model ClassPass {
  id               String   @id @default(cuid())
  userId           String
  purchaseId       String   @unique
  totalCredits     Int
  remainingCredits Int
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id])
  purchase Purchase             @relation(fields: [purchaseId], references: [id])
  usages   BookingCreditUsage[]

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  purchaseId String   @unique
  startsAt   DateTime
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model BookingCreditUsage {
  id          String   @id @default(cuid())
  bookingId   String
  classPassId String
  creditsUsed Int
  createdAt   DateTime @default(now())

  booking   Booking   @relation(fields: [bookingId], references: [id])
  classPass ClassPass @relation(fields: [classPassId], references: [id])

  @@unique([bookingId, classPassId])
  @@index([bookingId])
  @@index([classPassId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  classId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}
